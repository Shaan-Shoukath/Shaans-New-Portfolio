# Supabase (public anon key; RLS protects writes). Without these the site uses src/content/site.ts.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# GitHub stats on Projects (optional; the block hides without it). Fine-grained token,
# "Public repositories (read-only)", no other permissions.
GITHUB_TOKEN=

# Admin account used by the CMS
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Microsoft Clarity project ID (optional)
NEXT_PUBLIC_CLARITY_ID=

# Firebase Analytics web config (optional; all of apiKey, appId and measurementId are required to enable it)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Search console ownership tokens (optional)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=
